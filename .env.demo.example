# Instance de démonstration publique (ex. hébergement alwaysdata).
# Copier en .env sur le serveur, puis compléter les valeurs entre chevrons.
# Ne jamais versionner le .env réel.

APP_NAME=CRM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<compte>.alwaysdata.net

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Démonstration : blocage des opérations sensibles et réinitialisation autorisée
DEMO_MODE=true
DEMO_DATABASE_MARKER=demo

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base dédiée à la démonstration : son nom doit contenir « demo »
DB_CONNECTION=mysql
DB_HOST=mysql-<compte>.alwaysdata.net
DB_PORT=3306
DB_DATABASE=<compte>_demo
DB_USERNAME=<utilisateur_base>
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Aucun e-mail réel (forcé de toute façon par DEMO_MODE)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
